    "phonemeSegments": [
      [
        "b\u02c8\u0251T\u0259m l\u02c8In: \u0279\u02cc\u025bk\u0259m\u02c8\u025bnd s\u02c8\u025bnd\u026a\u014b \u0250 f\u02c8Ok\u0259st k\u0279\u02cc\u0254sf\u02c8\u028c\u014bk\u0283\u1d4an\u0259l t\u02c8im t\u0259 p\u02c8i p\u02c8i s\u02c8i s\u02c8i tw\u02c8\u025bnti tw\u02c8\u025bnti s\u02c8\u026aks w\u026a\u00f0 w\u02c8\u028cn \u0259b\u02a4\u02c8\u025bkt\u026av: \u0279\u0259t\u02c8\u025c\u0279n w\u026a\u00f0 \u0250 \u0261\u02c8\u028cv\u0259\u0279nd \u02c8A\u02ccI, \u02c8\u00e6p, \u00e6nd \u02cc\u0254T\u0259m\u02c8A\u0283\u0259n p\u02c8Il\u0259t p\u0279\u0259p\u02c8Oz\u1d4al."
      ],
      [
