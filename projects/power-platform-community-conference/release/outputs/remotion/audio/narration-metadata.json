  "segments": [
    {
      "endSeconds": 14.275,
      "index": 0,
      "startSeconds": 0.25,
      "text": "Bottom line: recommend sending a focused cross-functional team to PPCC 2026 with one objective: return with a governed AI, app, and automation pilot proposal."
    },
    {
      "endSeconds": 25.1,
      "index": 1,
      "startSeconds": 14.825,
      "text": "This is a recommendation, not a measured outcome. Treat the event as a structured learning sprint for business, platform, data, and risk leaders."
    },
    {
      "endSeconds": 37.475,
      "index": 2,
      "startSeconds": 25.65,
      "text": "PPCC runs October 27 through 29 at the MGM Grand in Las Vegas. Applied workshops run before and after the main conference."
    },
    {
      "endSeconds": 57.075,
      "index": 3,
      "startSeconds": 38.025,
      "text": "Microsoft frames PPCC around Copilot, agents, apps, automation, and data. The program connects those capabilities to trusted data, implementation, architecture, and governance. That is the bridge from innovation ambition to execution controls."
    },
    {
      "endSeconds": 71.2,
      "index": 4,
      "startSeconds": 57.625,
      "text": "After the event, require one pilot charter naming the workflow, owner, trusted data, guardrails, and a testable success measure. Expand only when that evidence supports the next decision."
    }
  ],
  "voice": {
