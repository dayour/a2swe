  "segments": [
    {
      "endSeconds": 9.91,
      "index": 0,
      "startSeconds": 0.25,
      "text": "Datadog for Claude Cowork. Your telemetry, one question away. Here is what the plugin does, how it connects, and where a team should be careful."
    },
    {
      "endSeconds": 23.571958333333335,
      "index": 1,
      "startSeconds": 10.46,
      "text": "The Datadog Model Context Protocol server bridges your observability data to agents. Logs, metrics, traces, dashboards, and monitors become things you can simply ask about."
    },
    {
      "endSeconds": 37.71929166666666,
      "index": 2,
      "startSeconds": 24.121958333333332,
      "text": "For Claude, including Cowork, the official connector is the recommended path, and it adds in-product visualizations. Claude Code installs the same server as a plugin from the official marketplace."
    },
    {
      "endSeconds": 51.16795833333333,
      "index": 3,
      "startSeconds": 38.26929166666667,
      "text": "Setup is short. Choose your Datadog site, then sign in with O Auth in the browser. Keys are an alternative, and any older manual server or custom connector should be removed first."
    },
    {
      "endSeconds": 62.991958333333336,
      "index": 4,
      "startSeconds": 51.717958333333335,
      "text": "Access is not widened. You still need the Datadog permissions for the data you query, and the plugin states that no Datadog credentials are sent to the model provider."
    },
    {
      "endSeconds": 71.70129166666666,
      "index": 5,
      "startSeconds": 63.54195833333333,
      "text": "Tool groups can be switched on or off, so a team can expose only the products it needs. Start with one narrow toolset."
    },
    {
      "endSeconds": 88.37129166666666,
      "index": 6,
      "startSeconds": 72.25129166666666,
      "text": "Treat the preview label as a rollout risk. The server is H I P A A eligible, yet you own compliance for the tools you connect, and government sites are not supported. Pilot with one team, keep permissions tight, then expand."
    }
  ],
  "voice": {
    "lang": "en-us",
    "speed": 1.0,
    "voice": "am_michael"
  }
