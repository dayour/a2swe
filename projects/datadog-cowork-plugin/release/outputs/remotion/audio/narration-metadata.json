  "segments": [
    {
      "endSeconds": 11.375,
      "index": 0,
      "sceneId": "title",
      "startSeconds": 0.25,
      "text": "The Datadog plugin and connector let Claude query Datadog logs, metrics, traces, dashboards and monitors through the Datadog MCP Server."
    },
    {
      "endSeconds": 23.55,
      "index": 1,
      "sceneId": "what-it-is",
      "startSeconds": 11.925,
      "text": "The Datadog MCP Server links your observability data to any agent that speaks the Model Context Protocol, so you ask instead of clicking through screens."
    },
    {
      "endSeconds": 33.375,
      "index": 2,
      "sceneId": "where-it-runs",
      "startSeconds": 24.1,
      "text": "Claude, including Cowork, uses the official connector. Claude Code installs the plugin from the official Anthropic marketplace."
    },
    {
      "endSeconds": 44.125,
      "index": 3,
      "sceneId": "setup",
      "startSeconds": 33.925,
      "text": "Choose your Datadog site and sign in with OAuth. Keys are supported, and older manual servers or custom connectors should be removed first."
    },
    {
      "endSeconds": 52.8,
      "index": 4,
      "sceneId": "access",
      "startSeconds": 44.675,
      "text": "You need Datadog permissions for the resources you query, and no Datadog credentials are sent to the model provider."
    },
    {
      "endSeconds": 61.625,
      "index": 5,
      "sceneId": "control",
      "startSeconds": 53.35,
      "text": "Enable or disable groups of MCP tools so the agent sees only the Datadog products your team needs."
    },
    {
      "endSeconds": 72.075,
      "index": 6,
      "sceneId": "risk",
      "startSeconds": 62.175,
      "text": "The plugin is in Preview. The server is HIPAA-eligible, but you own compliance for connected tools, and the government sites are unsupported."
    }
  ],
  "voice": {
    "lang": "a",
    "phonemeSegments": [
      [
        "\u00f0\u0259 d\u02c8AT\u0259d\u02cc\u0251\u0261 pl\u02c8\u028c\u0261\u026an \u00e6nd k\u0259n\u02c8\u025bkt\u0259\u0279 l\u02c8\u025bt kl\u02c8\u0254d kw\u02c8\u026a\u0279i d\u02c8AT\u0259d\u02cc\u0251\u0261 l\u02c8\u0254\u0261z, m\u02c8\u025bt\u0279\u026aks, t\u0279\u02c8As\u1d7bz, d\u02c8\u00e6\u0283b\u02cc\u0254\u0279dz \u00e6nd m\u02c8\u0251n\u0259T\u0259\u0279z \u03b8\u0279u \u00f0\u0259 d\u02c8AT\u0259d\u02cc\u0251\u0261 \u02cc\u025bms\u02ccip\u02c8i s\u02c8\u025c\u0279v\u0259\u0279."
      ],
      [
        "\u00f0\u0259 d\u02c8AT\u0259d\u02cc\u0251\u0261 \u02cc\u025bms\u02ccip\u02c8i s\u02c8\u025c\u0279v\u0259\u0279 l\u02c8\u026a\u014bks j\u028a\u0279 \u0259bz\u02cc\u025c\u0279v\u0259b\u02c8\u026al\u1d7bTi d\u02c8AT\u0259 t\u028a \u02c8\u025bni \u02c8A\u02a4\u1d4ant \u00f0\u00e6t sp\u02c8iks \u00f0\u0259 m\u02c8\u0251d\u1d4al k\u02c8\u0251nt\u025bkst p\u0279\u02c8OT\u0259k\u02cc\u0254l, s\u02ccO ju \u02c8\u00e6sk \u026anst\u02c8\u025bd \u028cv kl\u02c8\u026ak\u026a\u014b \u03b8\u0279u sk\u0279\u02c8inz."
      ],
      [
        "kl\u02c8\u0254d, \u026ankl\u02c8ud\u026a\u014b k\u02ccOw\u02c8\u025c\u0279k, j\u02c8uz\u1d7bz \u00f0i \u0259f\u02c8\u026a\u0283\u1d4al k\u0259n\u02c8\u025bkt\u0259\u0279. kl\u02c8\u0254d k\u02c8Od \u026anst\u02c8\u0254lz \u00f0\u0259 pl\u02c8\u028c\u0261\u026an f\u0279\u028cm \u00f0i \u0259f\u02c8\u026a\u0283\u1d4al \u00e6n\u03b8\u0279\u02c8\u0251p\u026ak m\u02c8\u0251\u0279k\u0259tpl\u02ccAs."
      ],
      [
        "\u02a7\u02c8uz j\u028a\u0279 d\u02c8AT\u0259d\u02cc\u0251\u0261 s\u02c8It \u00e6nd s\u02c8In \u02c8\u026an w\u026a\u00f0 \u02c8O\u02cc\u0254\u03b8. k\u02c8iz \u0251\u0279 s\u0259p\u02c8\u0254\u0279T\u1d7bd, \u00e6nd \u02c8Old\u0259\u0279 m\u02c8\u00e6nj\u0259w\u0259l s\u02c8\u025c\u0279v\u0259\u0279z \u0254\u0279 k\u02c8\u028cst\u0259m k\u0259n\u02c8\u025bkt\u0259\u0279z \u0283\u02cc\u028ad bi \u0279\u0259m\u02c8uvd f\u02c8\u025c\u0279st."
      ],
      [
        "j\u02ccu n\u02c8id d\u02c8AT\u0259d\u02cc\u0251\u0261 p\u0259\u0279m\u02c8\u026a\u0283\u0259nz f\u0254\u0279 \u00f0\u0259 \u0279\u02c8is\u02cc\u0254\u0279s\u1d7bz ju kw\u02c8\u026a\u0279i, \u00e6nd n\u02c8O d\u02c8AT\u0259d\u02cc\u0251\u0261 k\u0279\u0259d\u02c8\u025bn\u02a7\u1d4alz \u0251\u0279 s\u02c8\u025bnt t\u0259 \u00f0\u0259 m\u02c8\u0251d\u1d4al p\u0279\u0259v\u02c8Id\u0259\u0279."
      ],
      [
        "\u026an\u02c8Ab\u1d4al \u0254\u0279 d\u0259s\u02c8Ab\u1d4al \u0261\u0279\u02c8ups \u028cv \u02cc\u025bms\u02ccip\u02c8i t\u02c8ulz s\u02ccO \u00f0i \u02c8A\u02a4\u1d4ant s\u02c8iz \u02c8Onli \u00f0\u0259 d\u02c8AT\u0259d\u02cc\u0251\u0261 p\u0279\u02c8\u0251d\u02cc\u028ckts j\u028a\u0279 t\u02c8im n\u02c8idz."
      ],
      [
        "\u00f0\u0259 pl\u02c8\u028c\u0261\u026an \u026az \u026an p\u0279\u02c8ivj\u02ccu. \u00f0\u0259 s\u02c8\u025c\u0279v\u0259\u0279 \u026az h\u02cc\u026ap\u0259\u02c8\u025bl\u0259\u02a4\u0259b\u1d4al, b\u02cc\u028ct ju \u02c8On k\u0259mpl\u02c8I\u0259ns f\u0254\u0279 k\u0259n\u02c8\u025bkt\u1d7bd t\u02c8ulz, \u00e6nd \u00f0\u0259 \u0261\u02c8\u028cv\u0259\u0279nm\u0259nt s\u02c8Its \u0251\u0279 \u02cc\u028cns\u0259p\u02c8\u0254\u0279T\u1d7bd."
      ]
    ],
