  "segments": [
    {
      "endSeconds": 8.275,
      "index": 0,
      "sceneId": "title",
      "startSeconds": 0.25,
      "text": "Bottom line: standardize skills and MCP, then govern compatibility and ownership for each host."
    },
    {
      "endSeconds": 23.9,
      "index": 1,
      "sceneId": "three-routes",
      "startSeconds": 8.825,
      "text": "Cowork uses a Microsoft 365 app package. Declarative agents use MCP or REST API actions. GitHub Copilot uses plugin packages with portable and client-specific parts."
    },
    {
      "endSeconds": 36.8,
      "index": 2,
      "sceneId": "reuse-boundary",
      "startSeconds": 24.45,
      "text": "Reuse skill logic and MCP configuration where tested. Keep authentication, manifests, discovery and client-only components inside each host package."
    },
    {
      "endSeconds": 49.6,
      "index": 3,
      "sceneId": "supported-paths",
      "startSeconds": 37.35,
      "text": "REST API actions remain supported in declarative agents. Agent Plugins 1.0 adds portability, while legacy GitHub Copilot plugins continue to load."
    },
    {
      "endSeconds": 62.975,
      "index": 4,
      "sceneId": "portfolio",
      "startSeconds": 50.15,
      "text": "Assign one owner per capability and service. Publish a host compatibility matrix, version each package, and add routes only when demand justifies lifecycle cost."
    }
  ],
