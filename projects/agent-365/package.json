{
  "name": "a2swe-agent-365",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "agent": "node agent/run.mjs",
    "test:agent": "node --test agent/*.test.mjs",
    "evaluate:agent": "node agent/evaluate.mjs",
    "gate:media": "node agent/gate.mjs",
    "audio": "npm run gate:media && node scripts/python.mjs scripts/tts_build.py script/narration-review.txt",
    "build": "npm run typecheck && remotion bundle src/index.ts --out-dir build_production",
    "typecheck": "tsc --noEmit",
    "render": "npm run gate:media && remotion render src/index.ts Video",
    "still": "remotion still src/index.ts",
    "studio": "remotion studio src/index.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.523",
    "@remotion/media": "4.0.523",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.523"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "pptxgenjs": "4.0.1",
    "playwright": "1.53.0",
    "sharp": "0.35.4"
  }
}
