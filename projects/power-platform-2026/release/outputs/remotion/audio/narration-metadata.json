  "segments": [
    {
      "endSeconds": 13.825,
      "index": 0,
      "sceneId": "title",
      "startSeconds": 0.25,
      "text": "Bottom line: use one ALM path; ship a managed artifact, set target config, move data apart, and do DLP, test, license and approval checks before final go-live."
    },
    {
      "endSeconds": 26.575,
      "index": 1,
      "sceneId": "one-platform",
      "startSeconds": 14.375,
      "text": "Treat the suite as one platform for apps, flows, sites, agents and Dataverse data. Put lifecycle, security, test and release choices in one clear decision frame."
    },
    {
      "endSeconds": 39.175,
      "index": 2,
      "sceneId": "managed-artifact",
      "startSeconds": 27.125,
      "text": "Build change in an unmanaged solution, with source control as the source of truth. Export a managed solution as the build artifact that test and production receive."
    },
    {
      "endSeconds": 52.7,
      "index": 3,
      "sceneId": "config-and-data",
      "startSeconds": 39.725,
      "text": "Keep configuration and business records on separate tracks. Set connections, references and variables per target, then migrate table rows, because solutions carry no data."
    },
    {
      "endSeconds": 66.225,
      "index": 4,
      "sceneId": "release-gate",
      "startSeconds": 53.25,
      "text": "Automate with pipelines, or use Azure DevOps or GitHub when the route needs it. Before final production, check DLP policy, tests, analytics, approvals and licenses."
    }
  ],
