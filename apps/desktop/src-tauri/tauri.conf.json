{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "a2swe",
  "version": "0.1.0",
  "identifier": "com.a2swe.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "a2swe native console",
        "url": "index.html?window=main",
        "width": 1320,
        "height": 860,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "visible": true
      },
      {
        "label": "widget",
        "title": "a2swe agent",
        "url": "index.html?window=widget",
        "width": 380,
        "height": 300,
        "minWidth": 320,
        "minHeight": 220,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; frame-src http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": "all"
  }
}
