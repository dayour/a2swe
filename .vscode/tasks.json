{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "a2swe: produce project revision",
			"type": "shell",
			"command": "node packages/core/src/cli.ts revision-produce --root projects/${input:project}",
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "a2swe: analyze project revisions",
			"type": "shell",
			"command": "node packages/core/src/cli.ts revisions-analyze --root projects/${input:project}",
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "a2swe: verify project release",
			"type": "shell",
			"command": "node packages/core/src/cli.ts release-verify --root projects/${input:project}/release",
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	],
	"inputs": [
		{
			"id": "project",
			"type": "promptString",
			"description": "Project folder under projects/",
			"default": "microsoft-plugin-architecture"
		}
	]
}
